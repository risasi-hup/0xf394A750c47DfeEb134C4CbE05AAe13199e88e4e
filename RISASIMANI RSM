<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RISASIMANI (RSM) Token</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f7f6;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            color: #333;
        }
        .token-card {
            background: #ffffff;
            padding: 30px;
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
            text-align: center;
            max-width: 400px;
            width: 100%;
        }
        .token-logo {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            object-fit: cover;
            margin-bottom: 15px;
            border: 3px solid #f0f0f0;
            padding: 5px;
        }
        .token-name {
            font-size: 24px;
            font-weight: 700;
            margin: 0 0 5px;
        }
        .token-symbol {
            font-size: 16px;
            color: #888;
            font-weight: 500;
            margin-bottom: 25px;
        }
        .token-details {
            text-align: left;
            background: #f8f9fa;
            padding: 20px;
            border-radius: 12px;
            border: 1px solid #e9ecef;
        }
        .detail-item {
            margin-bottom: 12px;
            font-size: 14px;
        }
        .detail-item:last-child {
            margin-bottom: 0;
        }
        .detail-label {
            font-weight: 600;
            color: #555;
            display: block;
            margin-bottom: 4px;
        }
        .address-code {
            display: block;
            background: #eef1f4;
            padding: 8px;
            border-radius: 6px;
            font-family: 'Courier New', Courier, monospace;
            font-size: 13px;
            word-wrap: break-word;
            color: #0056b3;
        }
    </style>
</head>
<body>

    <div class="token-card">
        <!-- Logo URL'si PowerShell'deki başarılı test sonucundan alınmıştır -->
        <img src="https://github.com/user-attachments/assets/1952e3d4-3c21-409e-aa4c-2fd61c757ec7" alt="RISASIMANI Logo" class="token-logo">
        
        <h1 class="token-name">RISASIMANI</h1>
        <div class="token-symbol">RSM</div>

        <div class="token-details">
            <div class="detail-item">
                <span class="detail-label">Ağ (Chain ID)</span>
                56 (BSC - BNB Smart Chain)
            </div>
            <div class="detail-item">
                <span class="detail-label">Ondalık (Decimals)</span>
                18
            </div>
            <div class="detail-item">
                <span class="detail-label">Sözleşme Adresi (Address)</span>
                <span class="address-code">0xf394A750c47DfeEb134C4CbE05AAe13199e88e4e</span>
            </div>
        </div>
    </div>

</body>
</html>
